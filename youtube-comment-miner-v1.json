          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "content": "You classify YouTube comments on Indian Consumer Health product review videos (protein powders, nutrition drinks, probiotics, OTC vitamins).\n\nReturn STRICT JSON with these keys ONLY:\n- classification: one of [objection, use_case, trust_signal, competitor_mention, claim_reaction, noise]\n- theme: 2-4 word theme (e.g. \"taste\", \"price point\", \"recovery after surgery\", \"artificial sweetener\", \"texture\", \"pregnancy safe\")\n- competitor_named: brand name if any competitor is mentioned, else empty string\n\nClassification rules:\n- objection: complaint, doubt, negative experience, price pushback, taste/texture issue, ingredient concern\n- use_case: how the consumer uses the product (post-surgery recovery, pre-workout, elderly nutrition, kids growth, meal replacement)\n- trust_signal: why they buy — doctor recommended, used for years, parent's choice, hospital gave it, visible results\n- competitor_mention: names another brand (Protinex, Horlicks, Complan, Nutrigo, GNC, Whey Protein, etc.)\n- claim_reaction: direct response to a brand claim the YouTuber made (sugar content, protein grams, FSSAI approval, clinical study)\n- noise: spam, emoji-only, irrelevant, unrelated, or empty\n\nReturn JSON only, no prose.",
              "role": "system"
            },
            {
              "content": "={{ $json.snippet.topLevelComment.snippet.textOriginal }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.1
        }
      },
      "id": "113758e7-5b48-481e-ab3a-ca142b79953b",
      "name": "Classify Comment",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1824,
        800
      ],
      "typeVersion": 1.7,
      "credentials": {
        "openAiApi": {
          "id": "ImjGjWXSonlX5ViZ",
          "name": "OpenAI account 2"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "GPT-4o-mini with temp 0.1 for consistency. Output at $json.message.content as parsed JSON object."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Format row for Google Sheets Append\n// Columns match Stage 7 schema exactly\n\nconst seed = $('Split Seeds').item.json;\nconst videoDesc = $('Get Video Description').item.json;\nconst comment = $('Split Comments').item.json;\nconst classification = $input.item.json.message.content;\n\n// Author hash — DPDP compliance (Stage 5 decision)\n// Pure JS djb2 hash (n8n sandbox blocks require('crypto'))\nconst authorId = comment?.snippet?.topLevelComment?.snippet?.authorChannelId?.value || 'anon';\nfunction hash8(str) {\n  let h = 5381;\n  for (let i = 0; i < str.length; i++) {\n    h = ((h << 5) + h) + str.charCodeAt(i);\n    h = h & h;\n  }\n  return Math.abs(h).toString(16).padStart(8, '0').substring(0, 8);\n}\nconst authorHash = hash8(authorId);\n\n// Parse classification if it came back as string (fallback)\nlet cls = classification;\nif (typeof cls === 'string') {\n  try { cls = JSON.parse(cls); } catch(e) { cls = { classification: 'noise', theme: '', competitor_named: '' }; }\n}\n\nreturn {\n  json: {\n    'Date': new Date().toISOString().slice(0, 10),\n    'Brand': seed.brand,\n    'Video ID': seed.video_id,\n    'Video Title': videoDesc?.items?.[0]?.snippet?.title || '',\n    'Comment (verbatim)': comment?.snippet?.topLevelComment?.snippet?.textOriginal || '',\n    'Classification': cls.classification || '',\n    'Theme': cls.theme || '',\n    'Competitor Named': cls.competitor_named || '',\n    'Author Hash': authorHash,\n    'Likes': comment?.snippet?.topLevelComment?.snippet?.likeCount || 0\n  }\n};"
      },
